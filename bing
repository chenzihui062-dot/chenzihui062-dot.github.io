// ===== 更新排行榜 =====
function updateRank() {
    let top5 = algos.slice(0, 5);
    let html = '';
    top5.forEach((algo, idx) => {
        html += `<div class="rank-item"><span class="name">${idx+1}.${algo.name}</span><span class="rate">${algo.winRate}%</span></div>`;
    });
