// ===== 复制杀组 =====
window.copyKill = function(kill) {
    navigator.clipboard.writeText(kill).then(() => {
        alert(`已复制: ${kill}`);
    });
};

// ===== 历史弹窗 =====
window.showHistory = function(id) {
    let algo = algos.find(a => a.id === id);
    if (!algo) return;
    
    let html = '<table style="width:100%"><tr><th>期号</th><th>杀</th><th>实际</th><th>结果</th></tr>';
    algo.history.slice(0, 15).forEach(h => {
        html += `<tr>
            <td>${h.period}</td>
            <td><span style="color:#e46f6f;">${h.kill}</span></td>
            <td>${h.actual}</td>
            <td><span class="${h.ok ? 'hit-badge-sm' : 'miss-badge-sm'}">${h.ok ? '✅' : '❌'}</span></td>
        </tr>`;
    });
    html += `<tr><td colspan="4" style="padding:10px; text-align:center;">总胜率 ${algo.winRate}% (${algo.correct}/${algo.total})</td></tr>`;
    
    $('#modalTitle').text(algo.name + ' · 历史');
    $('#modalContent').html(html);
    $('#historyModal').addClass('active');
    $('#overlay').addClass('active');
};

window.closeModal = function() {
    $('#historyModal').removeClass('active');
    $('#overlay').removeClass('active');
};

