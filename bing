// ===== 渲染历史表格 =====
function renderHistory() {
    if (!lotteryData || lotteryData.length === 0) return;
    
    let html = '';
    lotteryData.slice(1, 21).forEach(item => {
        let pred = algos[0] ? predictAlgo(algos[0], lotteryData.slice(1)).kill : '大单';
        let hit = pred !== item.combo;
        
        html += `<tr>
            <td>${item.qihao}</td>
